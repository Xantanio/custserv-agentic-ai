# OmniOps AI - Environment Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL 16)
POSTGRES_USER=omniops
POSTGRES_PASSWORD=omniops_secret
POSTGRES_DB=omniops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omniops:omniops_secret@localhost:5432/omniops_db

# API & Webhooks
API_HOST=0.0.0.0
API_PORT=8000

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001

# Streamlit UI
STREAMLIT_PORT=8501

# A2A / Internal Liaison (Slack / Teams mock)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/A2A/SPECIALISTS

# LLM (D13/D19) - provedor trocável por configuração
# ollama | openai_compatible
LLM_PROVIDER=ollama
# Modo A (código no notebook, Ollama no PC Windows via VPN): http://<ip-da-vpn-do-pc>:11434
# Modo B (código rodando no próprio PC Windows):              http://localhost:11434
# Modo C (tudo no notebook, Ollama em contêiner só CPU, D30): http://localhost:11434 e LLM_TIMEOUT_SECONDS=300
LLM_BASE_URL=http://localhost:11434
# URL vista de DENTRO dos containers (docker-compose). Modo B: host.docker.internal; modo A: IP da VPN do PC
LLM_DOCKER_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b-instruct
# Só para APIs externas; o Ollama não usa chave. Nunca comitar valor real.
LLM_API_KEY=
LLM_TEMPERATURE=0
# Janela de contexto (tokens). Consome VRAM: com 8192 o modelo vai 45% para a CPU (D20).
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=120
# Modo de raciocínio (thinking): vazio = padrão do modelo; false = desligado; true = ligado
LLM_REASONING=

# Sobrescrita por papel (investigator | generalist | judge | translator).
# Campo ausente herda o valor global LLM_*. Exemplos:
# LLM_ROLES__INVESTIGATOR__MODEL=qwen3:8b
# LLM_ROLES__JUDGE__REASONING=true
# LLM_ROLES__TRANSLATOR__PROVIDER=openai_compatible
# LLM_ROLES__TRANSLATOR__BASE_URL=http://localhost:11434/v1
